# Local embedding sidecar for assistant memory (tg#27845): warm-resident
# multilingual-e5-small ONNX, loopback only. The model download happens on
# first start; the service is restartable and memory-bounded.
[Unit]
Description=AISIS Yandex memory embedding sidecar (e5-small ONNX)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/xp/aisis/services/yandex-station/code
ExecStart=%h/.local/share/aisis/embed-venv/bin/python %h/xp/aisis/services/yandex-station/code/embed_server.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
# The model reloads from disk; sacrifice this service under host pressure.
OOMScoreAdjust=200
MemoryHigh=900M
MemoryMax=1200M

[Install]
WantedBy=default.target
