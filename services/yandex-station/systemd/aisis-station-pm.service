[Unit]
Description=AISIS speech prompts through existing pm-owned ChatGPT browser
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/xp/aisis/services/yandex-station/code
Environment=PYTHONPATH=%h/.local/share/aisis/pm-deps
EnvironmentFile=%h/.config/aisis/runtime.env
ExecStart=%h/.local/share/agent-tools/chatgpt-guardian-venv/bin/python %h/xp/aisis/services/yandex-station/code/pm_cdp_server.py
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=infinity
UMask=0077

[Install]
WantedBy=default.target
