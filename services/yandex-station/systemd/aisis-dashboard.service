[Unit]
Description=aisis dashboard (control center, :8781)
After=docker.service network-online.target

[Service]
EnvironmentFile=%h/.config/aisis/ha-dashboard.env
ExecStart=%h/.local/share/aisis/venv/bin/python %h/xp/aisis/services/yandex-station/code/dashboard.py
Environment=AISIS_DASHBOARD_DIST=%h/.local/share/aisis/dashboard-ui/dist
RestartSec=3

[Install]
WantedBy=default.target
