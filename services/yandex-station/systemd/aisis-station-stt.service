[Unit]
Description=AISIS streaming speech gateway to existing Wyoming recognizer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/xp/aisis/services/yandex-station/code
EnvironmentFile=%h/.config/aisis/runtime.env
ExecStart=%h/.local/share/aisis/venv/bin/python %h/xp/aisis/services/yandex-station/code/stt_wyoming.py
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=10
UMask=0077

[Install]
WantedBy=default.target
