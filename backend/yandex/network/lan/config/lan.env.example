# Private LAN inventory for the always-on LAN front (DHCP + DNS relay + TLS front).
# Copy to $AISIS_CONFIG_DIR/lan.env (default ~/.config/aisis/lan.env), mode 600, and replace every value.
# This file and everything under ~/.config/aisis stay OUTSIDE the repository. Values below are documentation
# addresses (RFC 5737) and synthetic MACs; `bin/lan-validate.sh` fails clearly on a missing or malformed value.
# Plain KEY=VALUE shell syntax (quote lists); it is sourced, so do not put commands in it.

# --- hosts -----------------------------------------------------------------------------------------------------
# The always-on LAN host that runs the DHCP server, the DNS relay and the TLS front (it must have a static address).
AISIS_LAN_FRONT_ADDR=192.0.2.10
# ssh destination of that host (key based, non-interactive), and its LAN interface name.
AISIS_LAN_FRONT_SSH=front-host
AISIS_LAN_FRONT_IFACE=eth0
# The host that runs the recognition backend (stays where it is; the front only proxies to it) and the TCP ports the
# TLS front and the watcher depend on.
AISIS_LAN_BACKEND_ADDR=192.0.2.20
AISIS_LAN_BACKEND_PORTS="31115 18080"
# The one of those ports the TLS front proxies voice traffic to.
AISIS_LAN_BACKEND_UPSTREAM_PORT=31115
AISIS_LAN_GATEWAY=192.0.2.1

# --- speaker ---------------------------------------------------------------------------------------------------
AISIS_LAN_SPEAKER_ADDR=192.0.2.30
AISIS_LAN_SPEAKER_MAC=02:00:00:00:00:30
# adb endpoint (host:port) used by speaker/speaker-dns.sh
AISIS_LAN_SPEAKER_ADB=192.0.2.30:5555
# DNS server the speaker must use (normally the front host itself).
AISIS_LAN_RESOLVER=192.0.2.10

# --- DNS / DHCP ------------------------------------------------------------------------------------------------
# Explicit upstream DNS servers (also what every other DHCP client is told).
AISIS_LAN_UPSTREAM_DNS="198.51.100.1 198.51.100.2 198.51.100.3"
AISIS_LAN_DHCP_RANGE_START=192.0.2.100
AISIS_LAN_DHCP_RANGE_END=192.0.2.200
AISIS_LAN_DHCP_NETMASK=255.255.255.0
AISIS_LAN_DHCP_LEASE_TIME=3600s
# Private file of fixed leases, one `dhcp-host=<mac>,<ip>` line each (never committed). Optional; may be absent.
AISIS_LAN_DHCP_HOSTS_FILE=/home/example/.config/aisis/dhcp-hosts.conf

# --- compose project on the front host -------------------------------------------------------------------------
AISIS_LAN_PROJECT=aisis-lan
# Directory on the front host (relative to its $HOME) that holds the release copy, the compose override and state.
AISIS_LAN_FRONT_DIR=.local/share/aisis-lan
# Absolute path on the front host of the owner-only relay config directory (config.json, voice-nginx.conf).
AISIS_LAN_RELAY_CONFIG_DIR=/home/example/.local/share/aisis-lan/private
# Absolute path on the front host of the owner-only directory with the TLS front's per-list domain files (*.txt, the
# format of ../voice-domains/). It holds the real inventory and is never taken from the repository.
AISIS_LAN_VOICE_DOMAINS_DIR=/home/example/.local/share/aisis-lan/private/voice-domains
# Optional: image tags (defaults: <project>-https:local and <project>-dhcp:local). The watcher always runs as the ssh
# user front-install.sh connects with (its uid/gid are rendered into front.env), so there is no knob for them here.
#AISIS_LAN_TLS_IMAGE=aisis-lan-https:local
#AISIS_LAN_DHCP_IMAGE=aisis-lan-dhcp:local
