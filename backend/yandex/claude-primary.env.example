# COPY to ~/.config/aisis-yandex/claude-primary.env (chmod 0600); contains NO credential values.
# Loaded by the adapter drop-in AFTER runtime.env, so it overrides only these names.
# The release directory holds claude_primary.py and the unchanged chatgpt_pm.py side by side
# (the last-resort fallback imports it from the script directory).
AISIS_CHATGPT_COMMAND='["/home/USER/.local/share/aisis-yandex/venv/bin/python","/home/USER/.local/share/aisis-yandex/releases/claude-primary-RELEASE_ID/claude_primary.py"]'
# Ordered budgets: 3 x AISIS_CLAUDE_TIMEOUT + AISIS_PM_HTTP_TIMEOUT + 5 <= AISIS_ROUTER_TIMEOUT < AISIS_CHATGPT_TIMEOUT.
AISIS_CLAUDE_TIMEOUT=20
AISIS_PM_HTTP_TIMEOUT=240
AISIS_ROUTER_TIMEOUT=310
AISIS_CHATGPT_TIMEOUT=320
AISIS_CLAUDE_KEY_SOURCES=/home/USER/.config/aisis-yandex/claude-sources.json
AISIS_CLAUDE_STATE_DIR=/home/USER/.local/state/aisis-yandex/claude
AISIS_CLAUDE_MODEL=claude-sonnet-5-5
AISIS_CLAUDE_MAX_TOKENS=768
# Stateless by default: every API request carries only the current utterance.
# 0 keeps the existing text-free storage policy; 1..16 opts into bounded private context.
AISIS_CLAUDE_HISTORY_PAIRS=0
AISIS_CLAUDE_HISTORY_TTL=86400
