# COPY to ~/.config/aisis-yandex/runtime.env, chmod0600. Never commit real values.
AISIS_QUASAR_SOURCE=/home/USER/.cache/aisis-yandex/quasar-server
AISIS_RUNTIME_ENV=/home/USER/.config/aisis-yandex/runtime.env
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
GLAGOL_JWT_KEY=REPLACE_WITH_PERSISTENT_RANDOM_HEX
AISIS_CHATGPT_COMMAND='["/home/USER/.local/share/aisis-yandex/venv/bin/python","/home/USER/.local/share/aisis-yandex/chatgpt_pm.py"]'
AISIS_CHATGPT_TIMEOUT=250
AISIS_PM_REQUEST_TIMEOUT=230
AISIS_PM_REPLY_TIMEOUT=170
AISIS_PM_HTTP_TIMEOUT=240
AISIS_ADAPTER_PORT=31117
AISIS_STATE_DB=/home/USER/.local/state/aisis-yandex/adapter.sqlite3
# Required comma-separated known speaker IDs; empty configuration refuses startup.
AISIS_ALLOWED_STATIONS=
STT_GIGAAM_URL=ws://127.0.0.1:31121
TTS_OPENAI_API_KEY=local-loopback
FISH_API_KEY=
FISH_API_KEY_FILE=/home/USER/.config/aisis-yandex/fish.key
FISH_MODEL=s2.1-pro-free
# AISIS client of existing pm-owned browser (does not start a browser).
AISIS_PM_URL=http://127.0.0.1:31118/turn
AISIS_PM_TOKEN=REPLACE_WITH_PRIVATE_RANDOM_TOKEN
AISIS_PM_CDP=http://127.0.0.1:9222
AISIS_PM_WORKSPACE=home
AISIS_PM_GUARDIAN_STATE=/home/USER/.local/state/agent-tools/chatgpt-guardian/home/state.sqlite
AISIS_PM_STATE_DB=/home/USER/.local/state/aisis-yandex/pm.sqlite3
AISIS_WYOMING_URI=tcp://127.0.0.1:31122
AISIS_STT_LANGUAGE=ru
AISIS_STT_PORT=31121
